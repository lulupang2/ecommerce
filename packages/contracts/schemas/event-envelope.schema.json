{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techzone.local/contracts/event-envelope.schema.json",
  "title": "TECHZONE Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "source", "requestId", "correlationId", "causationId", "actorId", "occurredAt", "schemaVersion", "payload"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$" },
    "source": { "type": "string", "minLength": 1 },
    "requestId": { "type": ["string", "null"] },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": ["string", "null"] },
    "actorId": { "type": ["string", "null"] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "const": 1 },
    "payload": { "type": "object" }
  }
}
