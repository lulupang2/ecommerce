    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@techzone/eslint-config": "*",
    "@techzone/tsconfig": "*",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
