{
  "name": "@techzone/config",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    "./cache": {
      "types": "./src/cache.d.ts",
      "default": "./src/cache.cjs"
    },
    "./validation": "./src/validation.cjs",
    "./errors": "./src/errors.cjs",
    "./nest-runtime": {
      "types": "./src/nest-runtime.d.ts",
      "default": "./src/nest-runtime.cjs"
    }
  },
  "scripts": {
    "build": "node --check src/nest-runtime.cjs && node --check src/cache.cjs",
    "typecheck": "node --check src/nest-runtime.cjs && node --check src/cache.cjs",
    "lint": "node --check src/nest-runtime.cjs && node --check src/cache.cjs",
    "test": "node --test"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@techzone/auth-platform": "*",
    "@techzone/database": "*",
    "@techzone/messaging": "*",
    "@techzone/observability": "*",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "keyv": "^5.6.0",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
