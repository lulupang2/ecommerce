{
  "name": "techzone",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/services/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:mobile": "npm run build:web -w @techzone/mobile",
    "generate:api": "npm run generate -w @techzone/api-client",
    "lint": "turbo run lint && node tools/validation/boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start": "npm run start -w @techzone/storefront",
    "preview": "npm run start -w @techzone/storefront",
    "backend:auth": "npm run start -w @techzone/auth",
    "backend:catalog": "npm run start -w @techzone/catalog",
    "backend:cart": "npm run start -w @techzone/cart",
    "backend:order": "npm run start -w @techzone/order",
    "backend:payment": "npm run start -w @techzone/payment",
    "backend:inventory": "npm run start -w @techzone/inventory",
    "backend:notification": "npm run start -w @techzone/notification",
    "backend:fulfillment": "npm run start -w @techzone/fulfillment",
    "backend:procurement": "npm run start -w @techzone/procurement",
    "backend:admin": "npm run start -w @techzone/admin-query",
    "backend:gateway": "npm run start -w @techzone/api-gateway",
    "ms:up": "docker compose up --build",
    "mobile:sync": "npm run sync -w @techzone/mobile",
    "test:integration": "node tests/integration/run.mjs",
    "test:storefront": "node tests/storefront-e2e/run.mjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:contract": "node tests/contract/run.mjs",
    "test:security": "node tests/security/run.mjs",
    "test:resilience": "node tests/resilience/run.mjs",
    "db:migrate": "node tools/migrations/run.mjs",
    "k8s:render": "node tools/kubernetes/render.mjs",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@lexical/html": "^0.48.0",
    "@lexical/list": "^0.48.0",
    "@lexical/react": "^0.48.0",
    "@lexical/rich-text": "^0.48.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "amqplib": "^0.10.5",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "lexical": "^0.48.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.6",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3",
    "vite": "latest"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.0"
  }
}
