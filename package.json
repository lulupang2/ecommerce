    "lint": "node scripts/static-check.mjs",
    "typecheck": "npx tsc --noEmit --allowJs false --skipLibCheck --lib dom,es2022 --target es2022 --moduleResolution bundler --module preserve lib/generated/api-types.ts lib/generated/client.ts",
