    "backend:notification": "node backend/services/notification/server.js",
    "backend:fulfillment": "node backend/services/fulfillment/server.js",
    "backend:procurement": "node backend/services/procurement/server.js",
    "backend:admin": "node backend/services/admin/server.js",
    "backend:gateway": "node backend/services/gateway/server.js",
    "ms:up": "docker compose up --build",
