# Local Docker Compose overrides. Never commit real production secrets.
ADMIN_EMAIL=admin@techzone.local
ADMIN_PASSWORD=CHANGE_ME
AUTH_PRIVATE_KEY_BASE64=
AUTH_KEY_ID=techzone-local-1
JWT_ISSUER=techzone-auth
INTERNAL_API_KEY=CHANGE_ME
TOSS_SECRET_KEY=

# External providers (production)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
RABBIT_URL=amqps://USER:PASSWORD@HOST/VHOST
REDIS_URL=rediss://USER:PASSWORD@HOST:6379
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
CORS_ORIGIN=https://shop.example.com,https://admin.example.com
