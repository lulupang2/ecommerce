{
  "title": "TECHZONE 서비스 신뢰성",
  "uid": "techzone-reliability",
  "schemaVersion": 41,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "title": "서비스 요청률", "type": "timeseries", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by(service) (rate(techzone_http_requests_total[5m]))", "legendFormat": "{{service}}" }] },
    { "id": 2, "title": "오류율", "type": "timeseries", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by(service) (rate(techzone_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "{{service}}" }] },
    { "id": 3, "title": "HTTP p95", "type": "timeseries", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by(le,service) (rate(techzone_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}" }] },
    { "id": 4, "title": "Outbox / DLQ", "type": "timeseries", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }, "targets": [{ "expr": "techzone_outbox_pending", "legendFormat": "outbox {{service}}" }, { "expr": "techzone_dead_letters", "legendFormat": "DLQ {{service}}" }] }
  ]
}
